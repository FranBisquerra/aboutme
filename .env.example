# Production domain (used by Nginx + Certbot in the `pro` profile)
DOMAIN=example.dev

# Resend API key for transactional email (contact form)
RESEND_API_KEY=

# MariaDB (used by the `db` service and the backend datasource)
MARIADB_DATABASE=aboutme
MARIADB_USER=aboutme
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root
