# Production domain (used by Nginx + Certbot in the `pro` profile)
DOMAIN=example.dev

# Resend API key for transactional email (contact form)
RESEND_API_KEY=

# MariaDB (used by the `db` service and the backend datasource)
MARIADB_DATABASE=aboutme
MARIADB_USER=aboutme
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# Auth (backoffice). JWT_SECRET must be >= 32 bytes for HS256.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-bytes
# Initial admin user, provisioned on startup if it does not exist yet
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@franbisquerra.dev
ADMIN_PASSWORD=changeme
